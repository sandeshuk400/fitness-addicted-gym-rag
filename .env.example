# Copy this file to .env.prod and replace every CHANGE_ME value.
# Never commit the real file. It is ignored by Git.
#
# Generate a random secret in PowerShell (run once per secret):
#   $b = New-Object byte[] 48
#   [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b)

# --- Database ---
DB_PASSWORD=CHANGE_ME
# DB_NAME=gymdb
# DB_USER=gym

# --- Security ---
# Signs access tokens. At least 32 bytes.
JWT_SECRET=CHANGE_ME

# Origins allowed to call the API (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost

# --- First admin account (created only if no admin exists yet) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# --- Fingerprint door device ---
# Shared key the door device sends with each scan. At least 32 characters.
# Door scans are refused while this is blank.
DEVICE_API_KEY=CHANGE_ME

# --- Email (off by default) ---
EMAIL_ENABLED=false
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- AI assistant ---
# Where the backend finds Ollama. Needed only to use the assistant.
# http://host.docker.internal:11434 reaches Ollama running on your own PC from inside Docker.
# The models llama3.2 and nomic-embed-text must be pulled first (ollama pull ...).
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Copy to .env and adjust. Never commit the real .env file.
#
# NOTE: docker compose reads .env automatically, but the Spring Boot app does NOT.
# For the backend, set these as environment variables in your shell before `mvn spring-boot:run`
# (PowerShell example: $env:JWT_SECRET = "..."), or in your IDE run configuration.

# Database
DB_NAME=gymdb
DB_USER=gym
DB_PASSWORD=gym_dev_password
DB_URL=jdbc:postgresql://localhost:5432/gymdb

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Security (use a long random value, at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# First admin account, created at startup if no admin exists yet
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-password

# Frontend origins allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173
